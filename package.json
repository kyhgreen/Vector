{
  "name": "vector",
  "version": "1.0.0",
  "description": "Vector: learn money skills like a game.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:file": "vite build --mode single && node scripts/make-submission.mjs",
    "desktop": "npm run build:file && node scripts/prepare-desktop.mjs && electron desktop",
    "build:desktop": "npm run build:file && node scripts/prepare-desktop.mjs && electron-builder --win"
  },
  "type": "module",
  "devDependencies": {
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "canvas-confetti": "^1.9.4",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "private": true,
  "allowScripts": {
    "electron@44.9.1": true,
    "electron-winstaller": false
  }
}
